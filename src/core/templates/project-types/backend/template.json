{
  "name": "Backend Service",
  "description": "A backend API service",
  "directories": [
    "src/controllers",
    "src/models",
    "src/routes",
    "src/services",
    "src/middleware",
    "src/utils",
    "src/config",
    "tests/unit",
    "tests/integration",
    "scripts",
    "docs"
  ],
  "files": [
    {
      "path": "README.md",
      "template": "README.md"
    },
    {
      "path": ".gitignore",
      "template": "gitignore"
    },
    {
      "path": ".env.example",
      "template": "env.example"
    },
    {
      "path": "package.json",
      "template": "package.json"
    },
    {
      "path": "src/index.js",
      "template": "index.js"
    },
    {
      "path": "src/app.js",
      "template": "app.js"
    },
    {
      "path": "src/config/index.js",
      "template": "config.js"
    },
    {
      "path": "src/routes/health.js",
      "template": "health-route.js"
    },
    {
      "path": "src/middleware/error.js",
      "template": "error-middleware.js"
    },
    {
      "path": "Dockerfile",
      "template": "Dockerfile"
    }
  ],
  "postGenerate": [
    {
      "type": "npm",
      "action": "install",
      "message": "Installing dependencies..."
    },
    {
      "type": "git",
      "action": "init",
      "message": "Initializing git repository..."
    }
  ]
}